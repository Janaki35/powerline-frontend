<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Transmission Line Corridor - Tower Survey</name>
  <description>GPS survey points for 135KV, 220KV, and 400KV transmission towers</description>

  <Style id="kv135">
    <IconStyle><color>ff00ffff</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-circle.png</href></Icon></IconStyle>
  </Style>
  <Style id="kv220">
    <IconStyle><color>ff00a5ff</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-circle.png</href></Icon></IconStyle>
  </Style>
  <Style id="kv400">
    <IconStyle><color>ff0000ff</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon></IconStyle>
  </Style>

  <Folder>
    <name>135KV Line</name>
    <Placemark>
      <name>135KV Tower 1</name>
      <description>Altitude: 66.332 m</description>
      <styleUrl>#kv135</styleUrl>
      <Point><coordinates>85.263880,20.826015,66.332</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>135KV Tower 2</name>
      <description>Altitude: 79.012 m | 330m from Tower 1</description>
      <styleUrl>#kv135</styleUrl>
      <Point><coordinates>85.265309,20.823362,79.012</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>135KV Line Segment</name>
      <styleUrl>#kv135</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          85.263880,20.826015,66.332
          85.265309,20.823362,79.012
        </coordinates>
      </LineString>
    </Placemark>
  </Folder>

